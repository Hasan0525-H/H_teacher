{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hteacher-ai-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "PROVIDER_ORDER": "workers_ai,gemini,groq,openrouter",
    "PROVIDER_TIMEOUT_MS": "18000",
    "CF_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
